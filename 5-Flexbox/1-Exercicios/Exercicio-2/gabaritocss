/* Reset e Base Moderna */
* {
    margin: 0;
    padding: 0; 
    box-sizing: border-box; 
}

body {
    margin: 0;
    font-family: 'Segoe UI', Roboto, sans-serif;
    background-color: #09090b;
    color: #f4f4f5;
    
    /* Organiza Header, Main e Footer um abaixo do outro */
    display: flex;
    flex-direction: column;
    height: 100vh;
}

/* 1. HEADER (Largura Total) */
.header-total {
    height: 60px;
    background-color:green;
    border-bottom: 1px solid #27272a;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 30px;
}

.logo {
    font-weight: bold;
    color: #a855f7; /* Roxo moderno */
    letter-spacing: 1px;
}

/* 2. MAIN (Container das Colunas) */
.conteudo-central {
    display: flex; /* Ativa flex para as colunas ficarem lado a lado */
    flex: 1;       /* Faz o main "esticar" para empurrar o footer para o fim */
}

/* Coluna Esquerda (Ex: Barra Lateral) */
.coluna-esquerda {
    width: 250px;
    background-color:blue;
    border-right: 1px solid #27272a;
    padding: 20px;
}

.coluna-esquerda ul {
    list-style: none;
    padding: 0;
}

.coluna-esquerda li {
    padding: 12px;
    color: #a1a1aa;
    border-radius: 8px;
    cursor: pointer;
}

.coluna-esquerda li:hover {
    background-color: #27272a;
    color: white;
}

/* Coluna Direita (Ex: Área de Conteúdo) */
.coluna-direita {
    flex: 1; /* Ocupa todo o resto da largura */
    background-color: red;
    padding: 30px;
}

.card-exemplo {
    height: 200px;
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    border-radius: 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.5rem;
    font-weight: bold;
}

/* 3. FOOTER (Largura Total) */
.footer-total {
    height: 50px;
    background-color: yellow;
    border-top: 1px solid #27272a;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #71717a;
    font-size: 0.8rem;
}



